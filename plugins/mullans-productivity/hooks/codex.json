{
  "description": "Inject relevant evidence-backed project lessons without blocking host actions.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --host codex",
            "commandWindows": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --host codex",
            "timeout": 2,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|apply_patch|Read|Glob|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --host codex",
            "commandWindows": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --host codex",
            "timeout": 2,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --warn-missing-python --host codex",
            "commandWindows": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --warn-missing-python --host codex",
            "timeout": 2,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --host codex",
            "commandWindows": "node -e \"require(process.env.PLUGIN_ROOT+'/bin/session-learning-hook.js').main(process.argv.slice(1))\" -- --host codex",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
